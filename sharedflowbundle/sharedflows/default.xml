<SharedFlow name="default">
    <!-- Request Phase: Check Budget -->
    <Step>
        <Name>AM-InitQuotaWeight</Name>
        <Condition>sf_direction = "request"</Condition>
    </Step>
    <Step>
        <Name>Q-EnforceBudget-Request</Name>
        <Condition>sf_direction = "request"</Condition>
    </Step>

    <!-- Response Phase: Calculate Cost & Increment Budget -->
    <Step>
        <Name>EV-ExtractTokenCounts</Name>
        <Condition>sf_direction = "response"</Condition>
    </Step>
    <Step>
        <Name>AM-PrepareKVMKey</Name>
        <Condition>sf_direction = "response"</Condition>
    </Step>
    <Step>
        <Name>KVM-GetModelCosts</Name>
        <Condition>sf_direction = "response"</Condition>
    </Step>
    <Step>
        <Name>JS-CalculateCost</Name>
        <Condition>sf_direction = "response"</Condition>
    </Step>
    <Step>
        <!-- Increment budget counter. CountOnly="true" in the policy ensures this step never fails. -->
        <Name>Q-EnforceBudget-Response</Name>
        <Condition>sf_direction = "response"</Condition>
    </Step>
    <Step>
        <Name>DC-CollectCostMetrics</Name>
        <Condition>sf_direction = "response"</Condition>
    </Step>
    <Step>
        <Name>AM-SetCostHeaders</Name>
        <Condition>sf_direction = "response"</Condition>
    </Step>
</SharedFlow>
